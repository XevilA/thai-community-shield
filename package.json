{
  "name": "thai-community-shield",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Community Shield (ประชาอารักษ์) - AI-Powered Community Disaster Resilience & Emergency Decision Support for Wat Thewarat Kunchorn Community",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:api": "bun --filter \"@community-shield/api\" dev",
    "dev:app": "bun --filter \"@community-shield/app\" dev",
    "build": "bun --filter \"*\" build",
    "typecheck": "bun --filter \"*\" typecheck",
    "test": "bun --filter \"*\" test"
  },
  "keywords": [
    "disaster-resilience",
    "community-shield",
    "flood-evacuation",
    "react-native",
    "bun",
    "universal-app",
    "wat-thewarat-kunchorn"
  ],
  "author": "Antigravity & Thai Community Resilience Team",
  "license": "MIT",
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.0"
  }
}
